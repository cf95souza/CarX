{
  "name": "carx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @carx/web dev",
    "dev:api": "pnpm --filter @carx/api dev",
    "dev:admin": "pnpm --filter @carx/admin dev",
    "db:migrate": "pnpm --filter @carx/api migrate:up",
    "db:migrate:down": "pnpm --filter @carx/api migrate:down",
    "db:migrate:status": "pnpm --filter @carx/api migrate:status",
    "db:migrate:reset": "pnpm --filter @carx/api migrate:reset",
    "build": "pnpm -r build",
    "test:e2e": "playwright test",
    "lint": "eslint apps packages",
    "typecheck": "tsc -b",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.14.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2"
  }
}
