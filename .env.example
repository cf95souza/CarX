# ==============================================================================
# CARX SAAS — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env no desenvolvimento local. NUNCA envie credenciais reais ao git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE GERAL & PORTAS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3333
ADMIN_PORT=5174
WEB_PORT=5173
DOMAIN=carx.local

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (POSTGRESQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=carx_dev
POSTGRES_USER=carx_app
POSTGRES_PASSWORD=carx_local_secret_password
DATABASE_URL=postgresql://carx_app:carx_local_secret_password@localhost:5432/carx_dev

# Role administrativa sem RLS (usada exclusivamente para migrations e Super Admin)
DATABASE_ADMIN_URL=postgresql://carx_admin:carx_super_secret_password@localhost:5432/carx_dev

# ------------------------------------------------------------------------------
# 3. SEGURANÇA & AUTENTICAÇÃO (JWT ROTATIVO & CRIPTOGRAFIA)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=chave_secreta_jwt_minimo_32_caracteres_aleatorios_aqui
JWT_REFRESH_SECRET=chave_secreta_refresh_minimo_32_caracteres_aleatorios_aqui
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=chave_hexadecimal_32_bytes_para_criptografar_sessoes_wa

# ------------------------------------------------------------------------------
# 4. REDIS (CACHE, RATE LIMITING & FILAS BULLMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_secret_password
REDIS_URL=redis://:redis_local_secret_password@localhost:6379/0

# ------------------------------------------------------------------------------
# 5. STORAGE MINIO (S3 COMPATÍVEL PARA LAUDOS E FOTOS DE OS)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_carx_admin
MINIO_SECRET_KEY=minio_carx_secret_key
MINIO_BUCKET_MEDIA=carx-media
MINIO_BUCKET_INSPECTIONS=carx-inspections

# ------------------------------------------------------------------------------
# 6. GATEWAY DE WHATSAPP (MENSAGENS TRANSACIONAIS)
# ------------------------------------------------------------------------------
WA_GATEWAY_URL=http://localhost:3001
WA_GATEWAY_API_KEY=wa_internal_secret_api_key

# ------------------------------------------------------------------------------
# 7. PROVEDOR DE COBRANÇA RECORRENTE (ASAAS / MERCADO PAGO)
# ------------------------------------------------------------------------------
BILLING_PROVIDER=asaas
ASAAS_API_KEY=sua_chave_de_teste_do_asaas_sandbox
ASAAS_WEBHOOK_SECRET=segredo_do_webhook_para_validar_assinatura

# ------------------------------------------------------------------------------
# 8. E-MAIL TRANSACIONAL
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=sua_chave_resend_aqui
EMAIL_FROM=suporte@carx.com.br

