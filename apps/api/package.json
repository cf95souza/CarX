{
  "name": "@carx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/server.test.ts src/database/tenant-isolation.test.ts src/auth/auth.test.ts src/middlewares/rbac.test.ts src/audit/audit.test.ts src/plans/plans.test.ts src/branding/branding.test.ts src/storage/storage.test.ts src/superadmin/superadmin.test.ts src/provisioning/provisioning.test.ts src/billing/billing-dunning.test.ts src/customers/customers-vehicles.test.ts src/services/catalog-pricing.test.ts src/work-orders/work-orders.test.ts src/billing/payments.test.ts src/stock/stock.test.ts src/appointments/appointments.test.ts src/inspections/inspections.test.ts src/technician/technician.test.ts src/qa/qa.test.ts",
    "test:rls": "tsx --test src/database/tenant-isolation.test.ts",
    "test:auth": "tsx --test src/auth/auth.test.ts",
    "test:rbac": "tsx --test src/middlewares/rbac.test.ts",
    "test:audit": "tsx --test src/audit/audit.test.ts",
    "test:plans": "tsx --test src/plans/plans.test.ts",
    "test:branding": "tsx --test src/branding/branding.test.ts",
    "test:storage": "tsx --test src/storage/storage.test.ts",
    "test:superadmin": "tsx --test src/superadmin/superadmin.test.ts",
    "test:provisioning": "tsx --test src/provisioning/provisioning.test.ts",
    "test:dunning": "tsx --test src/billing/billing-dunning.test.ts",
    "test:customers": "tsx --test src/customers/customers-vehicles.test.ts",
    "test:catalog": "tsx --test src/services/catalog-pricing.test.ts",
    "test:work-orders": "tsx --test src/work-orders/work-orders.test.ts",
    "test:payments": "tsx --test src/billing/payments.test.ts",
    "test:stock": "tsx --test src/stock/stock.test.ts",
    "test:appointments": "tsx --test src/appointments/appointments.test.ts",
    "test:inspections": "tsx --test src/inspections/inspections.test.ts",
    "test:technician": "tsx --test src/technician/technician.test.ts",
    "test:qa": "tsx --test src/qa/qa.test.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "migrate:up": "tsx src/database/migrate.ts up",
    "migrate:down": "tsx src/database/migrate.ts down",
    "migrate:status": "tsx src/database/migrate.ts status",
    "migrate:reset": "tsx src/database/migrate.ts reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@carx/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.1",
    "@sentry/node": "^11.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.11.24",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}